<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Personalized Spending Tracker - Manage your personal finances with ease" />
    <title>@ViewData["Title"] - SpendingTracker</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Sidebar -->
        <nav id="sidebar" class="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-brand">
                    <i class="bi bi-wallet2 brand-icon"></i>
                    <span class="brand-text">SpendTracker</span>
                </div>
                <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar">
                    <i class="bi bi-chevron-left"></i>
                </button>
            </div>

            <div class="sidebar-user">
                <div class="user-avatar">
                    <span>@(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")</span>
                </div>
                <div class="user-info">
                    <span class="user-name">@User.Identity.Name</span>
                    <span class="user-role">Personal Finance</span>
                </div>
            </div>

            <ul class="sidebar-nav">
                <li class="nav-label">MAIN MENU</li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                       asp-controller="Home" asp-action="Index">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                </li>

                <li class="nav-label">FINANCE</li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Income" ? "active" : "")"
                       asp-controller="Income" asp-action="Index">
                        <i class="bi bi-arrow-down-circle-fill income-icon"></i>
                        <span>Income</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Expense" ? "active" : "")"
                       asp-controller="Expense" asp-action="Index">
                        <i class="bi bi-arrow-up-circle-fill expense-icon"></i>
                        <span>Expenses</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transaction" ? "active" : "")"
                       asp-controller="Transaction" asp-action="Index">
                        <i class="bi bi-arrow-left-right"></i>
                        <span>Transactions</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Budget" ? "active" : "")"
                       asp-controller="Budget" asp-action="Index">
                        <i class="bi bi-piggy-bank-fill"></i>
                        <span>Budgets</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Category" ? "active" : "")"
                       asp-controller="Category" asp-action="Index">
                        <i class="bi bi-tags-fill"></i>
                        <span>Categories</span>
                    </a>
                </li>

                <li class="nav-label">INSIGHTS</li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Analytics" ? "active" : "")"
                       asp-controller="Analytics" asp-action="Index">
                        <i class="bi bi-bar-chart-fill"></i>
                        <span>Analytics</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" ? "active" : "")"
                       asp-controller="Report" asp-action="Index">
                        <i class="bi bi-file-earmark-bar-graph-fill"></i>
                        <span>Reports</span>
                    </a>
                </li>

                <li class="nav-label">ACCOUNT</li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Account" && ViewContext.RouteData.Values["action"]?.ToString() == "EditProfile" ? "active" : "")"
                       asp-controller="Account" asp-action="EditProfile">
                        <i class="bi bi-person-gear"></i>
                        <span>Profile</span>
                    </a>
                </li>
                <li class="nav-item">
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="nav-link btn-logout w-100">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>Logout</span>
                        </button>
                    </form>
                </li>
            </ul>
        </nav>

        <!-- Main Wrapper -->
        <div class="main-wrapper" id="mainWrapper">
            <!-- Top Navbar -->
            <header class="top-navbar">
                <button class="navbar-toggler-btn" id="mobileSidebarToggle">
                    <i class="bi bi-list"></i>
                </button>

                <div class="navbar-search">
                    <form asp-controller="Transaction" asp-action="Index" method="get" class="d-flex">
                        <div class="search-box">
                            <i class="bi bi-search search-icon"></i>
                            <input type="text" name="search" placeholder="Search transactions..." class="search-input" />
                        </div>
                    </form>
                </div>

                <div class="navbar-actions">
                    <a asp-controller="Income" asp-action="Create" class="btn btn-add-quick me-2" title="Add Income">
                        <i class="bi bi-plus-circle"></i>
                        <span class="d-none d-md-inline">Add</span>
                    </a>
                    <div class="dropdown">
                        <button class="btn-user-avatar dropdown-toggle" data-bs-toggle="dropdown" id="userMenu">
                            <span>@(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li class="dropdown-header">@User.Identity.Name</li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="EditProfile"><i class="bi bi-person-gear me-2"></i>Profile</a></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Page Content -->
            <main class="page-content">
                @if (TempData["Success"] != null)
                {
                    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:9999">
                        <div class="toast toast-success show" role="alert" id="successToast">
                            <div class="toast-header">
                                <i class="bi bi-check-circle-fill text-success me-2"></i>
                                <strong class="me-auto">Success</strong>
                                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
                            </div>
                            <div class="toast-body">@TempData["Success"]</div>
                        </div>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:9999">
                        <div class="toast toast-error show" role="alert" id="errorToast">
                            <div class="toast-header">
                                <i class="bi bi-x-circle-fill text-danger me-2"></i>
                                <strong class="me-auto">Error</strong>
                                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
                            </div>
                            <div class="toast-body">@TempData["Error"]</div>
                        </div>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <!-- Custom JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // Auto-dismiss toasts
        document.addEventListener('DOMContentLoaded', function() {
            var toasts = document.querySelectorAll('.toast.show');
            toasts.forEach(function(toast) {
                setTimeout(function() {
                    var bsToast = bootstrap.Toast.getOrCreateInstance(toast);
                    bsToast.hide();
                }, 4000);
            });
        });
    </script>
</body>
</html>
