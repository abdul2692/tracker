@model string

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Error - SpendingTracker</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="auth-body d-flex align-items-center justify-content-center min-vh-100">
    <div class="text-center">
        <div class="error-code">@(Model ?? "Error")</div>
        <h2 class="mb-3">Oops! Something went wrong</h2>
        <p class="text-muted mb-4">We couldn't find the page you're looking for, or an error occurred.</p>
        <a href="/" class="btn btn-primary-custom">
            <i class="bi bi-house-fill me-2"></i>Back to Dashboard
        </a>
    </div>
</body>
</html>
