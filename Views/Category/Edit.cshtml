@model SpendingTracker.ViewModels.CategoryViewModel
@{
    ViewData["Title"] = "Edit Category";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Edit Category</h1>
        <p class="page-subtitle">Update your custom category</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary-custom"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-5">
        <div class="card-custom">
            <div class="card-custom-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small rounded-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label-custom"></label>
                        <input asp-for="Name" class="form-control form-control-dark" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Icon" class="form-label-custom">Icon (Bootstrap Icon class)</label>
                        <input asp-for="Icon" class="form-control form-control-dark" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Color" class="form-label-custom">Color</label>
                        <input asp-for="Color" type="color" class="form-control form-control-color color-picker" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary-custom">
                            <i class="bi bi-check-lg me-1"></i>Update Category
                        </button>
                        <a asp-action="Index" class="btn btn-secondary-custom">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
