@model IEnumerable<SpendingTracker.Models.Category>
@{
    ViewData["Title"] = "Categories";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Categories</h1>
        <p class="page-subtitle">Manage your expense categories</p>
    </div>
    <a asp-action="Create" class="btn btn-primary-custom">
        <i class="bi bi-plus-circle me-1"></i>New Category
    </a>
</div>

<div class="row g-3">
    @foreach (var cat in Model)
    {
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card-custom category-card">
                <div class="card-custom-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="category-icon-circle" style="background:@(cat.Color)22; color:@cat.Color">
                                <i class="@cat.Icon fs-4"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-600">@cat.Name</h6>
                                <small class="text-muted">@(cat.IsDefault ? "Default" : "Custom")</small>
                            </div>
                        </div>
                        @if (!cat.IsDefault)
                        {
                            <div class="d-flex gap-1">
                                <a asp-action="Edit" asp-route-id="@cat.Id" class="btn-icon btn-icon-edit" title="Edit">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@cat.Id" class="btn-icon btn-icon-delete" title="Delete">
                                    <i class="bi bi-trash-fill"></i>
                                </a>
                            </div>
                        }
                        else
                        {
                            <span class="badge badge-default">Default</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
