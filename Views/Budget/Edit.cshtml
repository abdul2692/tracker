@model SpendingTracker.ViewModels.BudgetViewModel
@{
    ViewData["Title"] = "Edit Budget";
}

<div class="page-header">
    <div><h1 class="page-title">Edit Budget</h1></div>
    <a asp-action="Index" class="btn btn-secondary-custom"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-6">
        <div class="card-custom">
            <div class="card-custom-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small rounded-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label-custom"></label>
                        <input asp-for="Name" class="form-control form-control-dark" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Amount" class="form-label-custom"></label>
                        <div class="input-group-custom">
                            <i class="bi bi-currency-dollar input-icon"></i>
                            <input asp-for="Amount" class="form-control-custom" type="number" step="0.01" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="BudgetType" class="form-label-custom"></label>
                        <select asp-for="BudgetType" class="form-select form-control-dark" id="budgetTypeSelect"
                                asp-items="Html.GetEnumSelectList<SpendingTracker.Models.BudgetType>()">
                        </select>
                    </div>

                    <div id="monthlyFields">
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label asp-for="Month" class="form-label-custom"></label>
                                <select asp-for="Month" class="form-select form-control-dark">
                                    @for (int m = 1; m <= 12; m++)
                                    {
                                        <option value="@m">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-6">
                                <label asp-for="Year" class="form-label-custom"></label>
                                <select asp-for="Year" class="form-select form-control-dark">
                                    @for (int y = DateTime.Now.Year - 1; y <= DateTime.Now.Year + 2; y++)
                                    {
                                        <option value="@y">@y</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div id="categoryField" style="display:none">
                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label-custom"></label>
                            <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select form-control-dark">
                                <option value="">-- Select Category --</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary-custom"><i class="bi bi-check-lg me-1"></i>Update Budget</button>
                        <a asp-action="Index" class="btn btn-secondary-custom">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const typeSelect = document.getElementById('budgetTypeSelect');
        const monthlyFields = document.getElementById('monthlyFields');
        const categoryField = document.getElementById('categoryField');
        function toggleFields() {
            const val = typeSelect.value;
            monthlyFields.style.display = val === 'Monthly' ? 'block' : 'none';
            categoryField.style.display = val === 'Category' ? 'block' : 'none';
        }
        typeSelect.addEventListener('change', toggleFields);
        toggleFields();
    </script>
}
