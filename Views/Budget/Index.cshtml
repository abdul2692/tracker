@model IEnumerable<SpendingTracker.ViewModels.BudgetStatusViewModel>
@{
    ViewData["Title"] = "Budgets";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Budgets</h1>
        <p class="page-subtitle">Track your spending against your budgets — @DateTime.Now.ToString("MMMM yyyy")</p>
    </div>
    <a asp-action="Create" class="btn btn-primary-custom">
        <i class="bi bi-plus-circle me-1"></i>New Budget
    </a>
</div>

@if (Model.Any())
{
    <div class="row g-4">
        @foreach (var status in Model)
        {
            <div class="col-12 col-lg-6">
                <div class="card-custom budget-status-card @(status.IsOverBudget ? "over-budget" : status.IsWarning ? "warning-budget" : "")">
                    <div class="card-custom-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h5 class="fw-600 mb-1">@status.Budget.Name</h5>
                                <span class="badge badge-type">@status.Budget.BudgetType</span>
                                @if (status.Budget.Category != null)
                                {
                                    <span class="badge-category ms-1" style="background:@(status.Budget.Category.Color)22;color:@status.Budget.Category.Color">
                                        @status.Budget.Category.Name
                                    </span>
                                }
                            </div>
                            <div class="d-flex gap-1 align-items-center">
                                @if (status.IsOverBudget)
                                {
                                    <span class="badge badge-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i>Over Budget</span>
                                }
                                else if (status.IsWarning)
                                {
                                    <span class="badge badge-warning"><i class="bi bi-exclamation-circle-fill me-1"></i>Warning</span>
                                }
                                else
                                {
                                    <span class="badge badge-success"><i class="bi bi-check-circle-fill me-1"></i>On Track</span>
                                }
                                <a asp-action="Edit" asp-route-id="@status.Budget.Id" class="btn-icon btn-icon-edit ms-1"><i class="bi bi-pencil-fill"></i></a>
                                <a asp-action="Delete" asp-route-id="@status.Budget.Id" class="btn-icon btn-icon-delete"><i class="bi bi-trash-fill"></i></a>
                            </div>
                        </div>

                        <div class="progress budget-progress mb-2" style="height:10px">
                            <div class="progress-bar @(status.IsOverBudget ? "bg-danger" : status.IsWarning ? "bg-warning" : "bg-success")"
                                 style="width:@Math.Min(status.PercentageUsed, 100)%;transition:width 1s ease"></div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <div>
                                <span class="text-muted small">Spent</span>
                                <div class="fw-600 @(status.IsOverBudget ? "text-danger" : "")">$@status.Spent.ToString("N2")</div>
                            </div>
                            <div class="text-center">
                                <span class="text-muted small">Used</span>
                                <div class="fw-600">@status.PercentageUsed.ToString("F0")%</div>
                            </div>
                            <div class="text-end">
                                <span class="text-muted small">Budget</span>
                                <div class="fw-600">$@status.Budget.Amount.ToString("N2")</div>
                            </div>
                        </div>

                        @if (status.IsOverBudget)
                        {
                            <div class="alert alert-danger-soft mt-3 mb-0 py-2 px-3 rounded-3 small">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                You've exceeded this budget by <strong>$@((status.Spent - status.Budget.Amount).ToString("N2"))</strong>
                            </div>
                        }
                        else if (status.IsWarning)
                        {
                            <div class="alert alert-warning-soft mt-3 mb-0 py-2 px-3 rounded-3 small">
                                <i class="bi bi-exclamation-circle-fill me-1"></i>
                                Only <strong>$@status.Remaining.ToString("N2")</strong> remaining in this budget
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state">
        <i class="bi bi-piggy-bank empty-icon"></i>
        <h5>No budgets set</h5>
        <p class="text-muted">Create a budget to track your spending limits.</p>
        <a asp-action="Create" class="btn btn-primary-custom mt-2"><i class="bi bi-plus-circle me-1"></i>Create Budget</a>
    </div>
}
