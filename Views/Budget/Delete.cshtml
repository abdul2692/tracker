@model SpendingTracker.Models.Budget
@{
    ViewData["Title"] = "Delete Budget";
}

<div class="page-header">
    <div><h1 class="page-title">Delete Budget</h1></div>
    <a asp-action="Index" class="btn btn-secondary-custom"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-5">
        <div class="card-custom border-danger-soft">
            <div class="card-custom-body text-center py-4">
                <i class="bi bi-exclamation-triangle-fill text-danger mb-3" style="font-size:3rem"></i>
                <h5 class="mb-3">Delete this budget?</h5>

                <div class="detail-box mb-4">
                    <div class="detail-row">
                        <span class="detail-label">Name</span>
                        <span class="detail-value fw-600">@Model.Name</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Amount</span>
                        <span class="detail-value fw-600">$@Model.Amount.ToString("N2")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Type</span>
                        <span class="detail-value">@Model.BudgetType</span>
                    </div>
                </div>

                <form asp-action="Delete" method="post" class="d-flex gap-2 justify-content-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger-custom"><i class="bi bi-trash-fill me-1"></i>Yes, Delete</button>
                    <a asp-action="Index" class="btn btn-secondary-custom">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
