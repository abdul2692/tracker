@model SpendingTracker.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">Welcome back! Here's your financial overview.</p>
    </div>
    <div class="page-actions">
        <a asp-controller="Income" asp-action="Create" class="btn btn-success-custom me-2">
            <i class="bi bi-plus-circle me-1"></i>Add Income
        </a>
        <a asp-controller="Expense" asp-action="Create" class="btn btn-danger-custom">
            <i class="bi bi-dash-circle me-1"></i>Add Expense
        </a>
    </div>
</div>

<!-- Summary Cards -->
<div class="row g-4 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card stat-card-income">
            <div class="stat-icon"><i class="bi bi-arrow-down-circle-fill"></i></div>
            <div class="stat-content">
                <span class="stat-label">Total Income</span>
                <span class="stat-value">$@Model.TotalIncome.ToString("N2")</span>
                <span class="stat-sub">This month: $@Model.MonthlyIncome.ToString("N2")</span>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card stat-card-expense">
            <div class="stat-icon"><i class="bi bi-arrow-up-circle-fill"></i></div>
            <div class="stat-content">
                <span class="stat-label">Total Expenses</span>
                <span class="stat-value">$@Model.TotalExpenses.ToString("N2")</span>
                <span class="stat-sub">This month: $@Model.MonthlyExpenses.ToString("N2")</span>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card @(Model.Balance >= 0 ? "stat-card-balance" : "stat-card-deficit")">
            <div class="stat-icon"><i class="bi bi-wallet-fill"></i></div>
            <div class="stat-content">
                <span class="stat-label">Net Balance</span>
                <span class="stat-value">$@Model.Balance.ToString("N2")</span>
                <span class="stat-sub">Monthly: $@Model.MonthlyBalance.ToString("N2")</span>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card stat-card-category">
            <div class="stat-icon"><i class="bi bi-fire"></i></div>
            <div class="stat-content">
                <span class="stat-label">Top Spending</span>
                <span class="stat-value">@Model.HighestSpendingCategory</span>
                <span class="stat-sub">$@Model.HighestSpendingAmount.ToString("N2")</span>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-4 mb-4">
    <div class="col-12 col-lg-5">
        <div class="card-custom">
            <div class="card-custom-header">
                <h5 class="card-custom-title"><i class="bi bi-pie-chart-fill me-2"></i>Expenses by Category</h5>
            </div>
            <div class="card-custom-body">
                <div class="chart-container-sm">
                    <canvas id="categoryPieChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-7">
        <div class="card-custom">
            <div class="card-custom-header">
                <h5 class="card-custom-title"><i class="bi bi-graph-up me-2"></i>Income vs Expenses (6 Months)</h5>
            </div>
            <div class="card-custom-body">
                <div class="chart-container">
                    <canvas id="trendLineChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Budget Status + Recent Transactions -->
<div class="row g-4">
    @if (Model.BudgetStatuses.Any())
    {
        <div class="col-12 col-lg-4">
            <div class="card-custom h-100">
                <div class="card-custom-header">
                    <h5 class="card-custom-title"><i class="bi bi-piggy-bank-fill me-2"></i>Budget Status</h5>
                    <a asp-controller="Budget" asp-action="Index" class="btn-link-custom">View All</a>
                </div>
                <div class="card-custom-body">
                    @foreach (var status in Model.BudgetStatuses.Take(5))
                    {
                        <div class="budget-item mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-500">@status.Budget.Name</span>
                                <span class="badge @(status.IsOverBudget ? "badge-danger" : status.IsWarning ? "badge-warning" : "badge-success")">
                                    @(status.IsOverBudget ? "Over Budget" : status.IsWarning ? "Warning" : "OK")
                                </span>
                            </div>
                            <div class="progress budget-progress">
                                <div class="progress-bar @(status.IsOverBudget ? "bg-danger" : status.IsWarning ? "bg-warning" : "bg-success")"
                                     style="width: @Math.Min(status.PercentageUsed, 100)%"></div>
                            </div>
                            <div class="d-flex justify-content-between mt-1">
                                <small class="text-muted">$@status.Spent.ToString("N2") spent</small>
                                <small class="text-muted">$@status.Budget.Amount.ToString("N2") budget</small>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="col-12 @(Model.BudgetStatuses.Any() ? "col-lg-8" : "")">
        <div class="card-custom">
            <div class="card-custom-header">
                <h5 class="card-custom-title"><i class="bi bi-clock-history me-2"></i>Recent Transactions</h5>
                <a asp-controller="Transaction" asp-action="Index" class="btn-link-custom">View All</a>
            </div>
            <div class="card-custom-body p-0">
                @if (Model.RecentExpenses.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-custom mb-0">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th>Category</th>
                                    <th>Date</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var expense in Model.RecentExpenses)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <span class="category-dot me-2" style="background:@expense.Category.Color"></span>
                                                @(expense.Description ?? expense.Category.Name)
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge-category" style="background:@(expense.Category.Color)22; color:@expense.Category.Color">
                                                <i class="@expense.Category.Icon me-1"></i>@expense.Category.Name
                                            </span>
                                        </td>
                                        <td class="text-muted">@expense.Date.ToString("MMM dd")</td>
                                        <td class="text-end fw-600 text-danger">-$@expense.Amount.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-receipt empty-icon"></i>
                        <p>No transactions yet. <a asp-controller="Expense" asp-action="Create">Add your first expense</a></p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const categoryData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpensesByCategory));
        const trendData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrend));

        // Pie Chart
        const pieCtx = document.getElementById('categoryPieChart');
        if (pieCtx && Object.keys(categoryData).length > 0) {
            const colors = ['#FF6384','#36A2EB','#FFCE56','#4BC0C0','#9966FF','#FF9F40','#FF6384','#C9CBCF','#97BBCD'];
            new Chart(pieCtx, {
                type: 'doughnut',
                data: {
                    labels: Object.keys(categoryData),
                    datasets: [{
                        data: Object.values(categoryData),
                        backgroundColor: colors.slice(0, Object.keys(categoryData).length),
                        borderWidth: 0,
                        hoverOffset: 8
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { padding: 16, color: '#a0aec0', font: { size: 11 } } },
                        tooltip: { callbacks: { label: ctx => ` ${ctx.label}: $${ctx.raw.toFixed(2)}` } }
                    },
                    cutout: '65%'
                }
            });
        } else if (pieCtx) {
            pieCtx.parentElement.innerHTML = '<div class="empty-state"><i class="bi bi-pie-chart empty-icon"></i><p>No expense data</p></div>';
        }

        // Line Chart
        const lineCtx = document.getElementById('trendLineChart');
        if (lineCtx && trendData.length > 0) {
            new Chart(lineCtx, {
                type: 'line',
                data: {
                    labels: trendData.map(d => d.Month),
                    datasets: [
                        {
                            label: 'Income',
                            data: trendData.map(d => d.Income),
                            borderColor: '#10b981',
                            backgroundColor: 'rgba(16,185,129,0.1)',
                            tension: 0.4, fill: true, pointRadius: 4
                        },
                        {
                            label: 'Expenses',
                            data: trendData.map(d => d.Expenses),
                            borderColor: '#ef4444',
                            backgroundColor: 'rgba(239,68,68,0.1)',
                            tension: 0.4, fill: true, pointRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { labels: { color: '#a0aec0' } } },
                    scales: {
                        x: { grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#a0aec0' } },
                        y: { grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#a0aec0', callback: v => '$' + v } }
                    }
                }
            });
        }
    </script>
}
