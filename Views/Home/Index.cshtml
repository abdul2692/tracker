@model SpendingTracker.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var monthName = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.SelectedMonth);
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
    <div>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">Overview for @monthName @Model.SelectedYear</p>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <!-- Month & Year Filter Form -->
        <form method="get" asp-action="Index" id="dashFilterForm" class="d-flex align-items-center gap-2">
            <select name="month" id="dashMonthSelect" class="form-select form-select-sm form-control-dark" onchange="this.form.submit()">
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(m == Model.SelectedMonth)">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)</option>
                }
            </select>
            <select name="year" id="dashYearSelect" class="form-select form-select-sm form-control-dark" onchange="this.form.submit()">
                @for (int y = DateTime.Now.Year - 3; y <= DateTime.Now.Year + 1; y++)
                {
                    <option value="@y" selected="@(y == Model.SelectedYear)">@y</option>
                }
            </select>
        </form>

        <a asp-controller="Income" asp-action="Create" class="btn btn-success-custom">
            <i class="bi bi-plus-circle me-1"></i>Add Income
        </a>
        <a asp-controller="Expense" asp-action="Create" class="btn btn-danger-custom">
            <i class="bi bi-dash-circle me-1"></i>Add Expense
        </a>
    </div>
</div>

<!-- Summary Cards -->
<div class="row g-4 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card stat-card-income">
            <div class="stat-icon"><i class="bi bi-arrow-down-circle-fill"></i></div>
            <div class="stat-content">
                <span class="stat-label">Total Income</span>
                <span class="stat-value text-success" id="cardTotalIncome">@ViewBag.CurrencySymbol@Model.TotalIncome.ToString("N2")</span>
                <span class="stat-sub">@monthName @Model.SelectedYear</span>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card stat-card-expense">
            <div class="stat-icon"><i class="bi bi-arrow-up-circle-fill"></i></div>
            <div class="stat-content">
                <span class="stat-label">Total Expenses</span>
                <span class="stat-value text-danger" id="cardTotalExpenses">@ViewBag.CurrencySymbol@Model.TotalExpenses.ToString("N2")</span>
                <span class="stat-sub">@monthName @Model.SelectedYear</span>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card @(Model.Balance >= 0 ? "stat-card-balance" : "stat-card-deficit")">
            <div class="stat-icon"><i class="bi bi-wallet-fill"></i></div>
            <div class="stat-content">
                <span class="stat-label">Net Balance</span>
                <span class="stat-value @(Model.Balance >= 0 ? "text-success" : "text-danger")" id="cardNetBalance">
                    @ViewBag.CurrencySymbol@Model.Balance.ToString("N2")
                </span>
                <span class="stat-sub">Monthly balance</span>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card stat-card-category">
            <div class="stat-icon"><i class="bi bi-fire"></i></div>
            <div class="stat-content">
                <span class="stat-label">Top Spending</span>
                <span class="stat-value" id="cardTopCategory">@Model.HighestSpendingCategory</span>
                <span class="stat-sub" id="cardTopAmount">@ViewBag.CurrencySymbol@Model.HighestSpendingAmount.ToString("N2")</span>
            </div>
        </div>
    </div>
</div>

<!-- Charts Row -->
<div class="row g-4 mb-4">
    <!-- Category Doughnut Chart -->
    <div class="col-12 col-lg-5">
        <div class="card-custom h-100">
            <div class="card-custom-header">
                <h5 class="card-custom-title"><i class="bi bi-pie-chart-fill me-2"></i>Expenses by Category</h5>
            </div>
            <div class="card-custom-body" id="categoryPieWrapper">
                <div class="chart-container-sm">
                    <canvas id="categoryPieChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Trend Line Chart with View Switcher -->
    <div class="col-12 col-lg-7">
        <div class="card-custom h-100">
            <div class="card-custom-header d-flex justify-content-between align-items-center">
                <h5 class="card-custom-title mb-0"><i class="bi bi-graph-up me-2"></i>Income vs Expenses</h5>
                <div class="btn-group btn-group-sm" role="group" id="chartViewSwitcher">
                    <button type="button" class="btn btn-outline-secondary active" data-view="Daily">Daily</button>
                    <button type="button" class="btn btn-outline-secondary" data-view="Weekly">Weekly</button>
                    <button type="button" class="btn btn-outline-secondary" data-view="Monthly">Monthly</button>
                </div>
            </div>
            <div class="card-custom-body">
                <div class="chart-container">
                    <canvas id="trendLineChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Budget Status + Recent Transactions -->
<div class="row g-4">
    @if (Model.BudgetStatuses.Any())
    {
        <div class="col-12 col-lg-4">
            <div class="card-custom h-100">
                <div class="card-custom-header">
                    <h5 class="card-custom-title"><i class="bi bi-piggy-bank-fill me-2"></i>Budget Status</h5>
                    <a asp-controller="Budget" asp-action="Index" class="btn-link-custom">View All</a>
                </div>
                <div class="card-custom-body" id="budgetStatusWrapper">
                    @foreach (var status in Model.BudgetStatuses.Take(5))
                    {
                        <div class="budget-item mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-500">@status.Budget.Name</span>
                                <span class="badge @(status.IsOverBudget ? "badge-danger" : status.IsWarning ? "badge-warning" : "badge-success")">
                                    @(status.IsOverBudget ? "Over Budget" : status.IsWarning ? "Warning" : "OK")
                                </span>
                            </div>
                            <div class="progress budget-progress">
                                <div class="progress-bar @(status.IsOverBudget ? "bg-danger" : status.IsWarning ? "bg-warning" : "bg-success")"
                                     style="width: @Math.Min(status.PercentageUsed, 100)%"></div>
                            </div>
                            <div class="d-flex justify-content-between mt-1">
                                <small class="text-muted">@ViewBag.CurrencySymbol@status.Spent.ToString("N2") spent</small>
                                <small class="text-muted">@ViewBag.CurrencySymbol@status.Budget.Amount.ToString("N2") budget</small>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="col-12 @(Model.BudgetStatuses.Any() ? "col-lg-8" : "")">
        <div class="card-custom">
            <div class="card-custom-header">
                <h5 class="card-custom-title"><i class="bi bi-clock-history me-2"></i>Recent Transactions</h5>
                <a asp-controller="Transaction" asp-action="Index" class="btn-link-custom">View All</a>
            </div>
            <div class="card-custom-body p-0" id="recentTransactionsWrapper">
                @if (Model.RecentExpenses.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-custom mb-0">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th>Category</th>
                                    <th>Date</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var expense in Model.RecentExpenses)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <span class="category-dot me-2" style="background:@expense.Category.Color"></span>
                                                @(expense.Description ?? expense.Category.Name)
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge-category" style="background:@(expense.Category.Color)22; color:@expense.Category.Color">
                                                <i class="@expense.Category.Icon me-1"></i>@expense.Category.Name
                                            </span>
                                        </td>
                                        <td class="text-muted">@expense.Date.ToString("MMM dd")</td>
                                        <td class="text-end fw-600 text-danger">-@ViewBag.CurrencySymbol@expense.Amount.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state py-4">
                        <i class="bi bi-receipt empty-icon fs-1 text-muted mb-2 d-block"></i>
                        <h6 class="fw-600">No expenses recorded for this month.</h6>
                        <p class="text-muted small">Start tracking your spending by adding an expense.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const initialCategoryData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpensesByCategory));
        let activeView = 'Daily';
        let currentMonth = @Model.SelectedMonth;
        let currentYear = @Model.SelectedYear;

        let pieChartInstance = null;
        let trendChartInstance = null;

        function getThemeColors() {
            const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            return {
                gridColor: isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)',
                textColor: isDark ? '#a0aec0' : '#4a5568'
            };
        }

        // Render Doughnut Pie Chart
        function renderPieChart(dataMap) {
            const pieCtx = document.getElementById('categoryPieChart');
            if (!pieCtx) return;

            if (pieChartInstance) pieChartInstance.destroy();

            const keys = Object.keys(dataMap || {});
            const values = Object.values(dataMap || {});

            if (keys.length > 0) {
                const colors = ['#FF6384','#36A2EB','#FFCE56','#4BC0C0','#9966FF','#FF9F40','#C9CBCF','#97BBCD','#10b981','#ef4444'];
                pieChartInstance = new Chart(pieCtx, {
                    type: 'doughnut',
                    data: {
                        labels: keys,
                        datasets: [{
                            data: values,
                            backgroundColor: colors.slice(0, keys.length),
                            borderWidth: 0,
                            hoverOffset: 8
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '65%',
                        plugins: {
                            legend: { position: 'bottom', labels: { padding: 14, color: getThemeColors().textColor, font: { size: 11 } } },
                            tooltip: { callbacks: { label: ctx => ` ${ctx.label}: ${window.formatCurrency(ctx.raw)}` } }
                        }
                    }
                });
            } else {
                pieCtx.parentElement.innerHTML = '<div class="empty-state py-4"><i class="bi bi-pie-chart empty-icon fs-1 text-muted mb-2 d-block"></i><p class="text-muted small">No expenses recorded for this month.</p></div>';
            }
        }

        // Fetch & Render Dynamic Trend Chart (Daily / Weekly / Monthly)
        function loadTrendChart(view, month, year) {
            const lineCtx = document.getElementById('trendLineChart');
            if (!lineCtx) return;

            fetch(`/Home/GetChartData?view=${view}&month=${month}&year=${year}`)
                .then(res => res.json())
                .then(data => {
                    const theme = getThemeColors();
                    if (trendChartInstance) trendChartInstance.destroy();

                    trendChartInstance = new Chart(lineCtx, {
                        type: 'line',
                        data: {
                            labels: data.labels,
                            datasets: [
                                {
                                    label: 'Income',
                                    data: data.incomeData,
                                    borderColor: '#10b981',
                                    backgroundColor: 'rgba(16,185,129,0.1)',
                                    tension: 0.3,
                                    fill: true,
                                    pointRadius: 4
                                },
                                {
                                    label: 'Expenses',
                                    data: data.expenseData,
                                    borderColor: '#ef4444',
                                    backgroundColor: 'rgba(239,68,68,0.1)',
                                    tension: 0.3,
                                    fill: true,
                                    pointRadius: 4
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { labels: { color: theme.textColor } },
                                tooltip: { callbacks: { label: ctx => ` ${ctx.dataset.label}: ${window.formatCurrency(ctx.raw)}` } }
                            },
                            scales: {
                                x: { grid: { color: theme.gridColor }, ticks: { color: theme.textColor } },
                                y: { grid: { color: theme.gridColor }, ticks: { color: theme.textColor, callback: v => window.formatCurrency(v) } }
                            }
                        }
                    });
                });
        }

        document.addEventListener('DOMContentLoaded', () => {
            renderPieChart(initialCategoryData);
            loadTrendChart(activeView, currentMonth, currentYear);

            // Chart View Switcher Listener (Daily / Weekly / Monthly)
            const switcher = document.getElementById('chartViewSwitcher');
            if (switcher) {
                switcher.querySelectorAll('button').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        switcher.querySelectorAll('button').forEach(b => b.classList.remove('active'));
                        e.target.classList.add('active');
                        activeView = e.target.getAttribute('data-view');
                        loadTrendChart(activeView, currentMonth, currentYear);
                    });
                });
            }
        });
    </script>
}
