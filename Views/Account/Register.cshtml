@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register - SpendingTracker</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <script>
        (function () { var t = localStorage.getItem('theme') || 'light'; document.documentElement.setAttribute('data-theme', t); })();
    </script>
</head>
<body class="auth-body">
    <!-- Theme toggle -->
    <button class="theme-toggle-auth" id="authThemeToggle" title="Toggle theme" aria-label="Toggle theme">
        <i class="bi bi-sun-fill" id="authThemeIcon"></i>
    </button>

    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-brand">
                <i class="bi bi-wallet2 brand-icon-lg"></i>
                <h1 class="auth-title">SpendTracker</h1>
                <p class="auth-subtitle">Create your account to get started</p>
            </div>

            <form asp-action="Register" method="post" class="auth-form">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

                <div class="row g-3">
                    <div class="col-6">
                        <label asp-for="FirstName" class="form-label-custom"></label>
                        <div class="input-group-custom">
                            <i class="bi bi-person input-icon"></i>
                            <input asp-for="FirstName" class="form-control-custom" placeholder="First name" />
                        </div>
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="LastName" class="form-label-custom"></label>
                        <div class="input-group-custom">
                            <i class="bi bi-person input-icon"></i>
                            <input asp-for="LastName" class="form-control-custom" placeholder="Last name" />
                        </div>
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-3">
                    <label asp-for="Email" class="form-label-custom"></label>
                    <div class="input-group-custom">
                        <i class="bi bi-envelope input-icon"></i>
                        <input asp-for="Email" class="form-control-custom" placeholder="your@email.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mt-3">
                    <label asp-for="Password" class="form-label-custom"></label>
                    <div class="input-group-custom">
                        <i class="bi bi-lock input-icon"></i>
                        <input asp-for="Password" id="registerPassword" class="form-control-custom" placeholder="Create a strong password" type="password" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>

                    <!-- Real-time password requirements -->
                    <div class="pw-requirements mt-2" id="pwChecklist">
                        <div class="pw-req" id="req-len">
                            <i class="bi bi-x-circle-fill pw-fail"></i>
                            <i class="bi bi-check-circle-fill pw-pass d-none"></i>
                            At least 8 characters
                        </div>
                        <div class="pw-req" id="req-upper">
                            <i class="bi bi-x-circle-fill pw-fail"></i>
                            <i class="bi bi-check-circle-fill pw-pass d-none"></i>
                            At least one uppercase letter (A-Z)
                        </div>
                        <div class="pw-req" id="req-lower">
                            <i class="bi bi-x-circle-fill pw-fail"></i>
                            <i class="bi bi-check-circle-fill pw-pass d-none"></i>
                            At least one lowercase letter (a-z)
                        </div>
                        <div class="pw-req" id="req-digit">
                            <i class="bi bi-x-circle-fill pw-fail"></i>
                            <i class="bi bi-check-circle-fill pw-pass d-none"></i>
                            At least one number (0-9)
                        </div>
                        <div class="pw-req" id="req-special">
                            <i class="bi bi-x-circle-fill pw-fail"></i>
                            <i class="bi bi-check-circle-fill pw-pass d-none"></i>
                            At least one special character (!@@#$...)
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <label asp-for="ConfirmPassword" class="form-label-custom"></label>
                    <div class="input-group-custom">
                        <i class="bi bi-lock-fill input-icon"></i>
                        <input asp-for="ConfirmPassword" class="form-control-custom" placeholder="Confirm password" type="password" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-auth mt-4">
                    <i class="bi bi-person-plus me-2"></i>Create Account
                </button>

                <p class="auth-footer">
                    Already have an account? <a asp-action="Login" class="auth-link">Sign in</a>
                </p>
            </form>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script>
        // -- Password strength checklist --------------------------------------
        (function () {
            var pwInput = document.getElementById('registerPassword');
            if (!pwInput) return;

            function check(id, test) {
                var el = document.getElementById(id);
                var pass = el.querySelector('.pw-pass');
                var fail = el.querySelector('.pw-fail');
                if (test) {
                    pass.classList.remove('d-none');
                    fail.classList.add('d-none');
                    el.classList.add('met');
                } else {
                    pass.classList.add('d-none');
                    fail.classList.remove('d-none');
                    el.classList.remove('met');
                }
            }

            pwInput.addEventListener('input', function () {
                var v = this.value;
                check('req-len',     v.length >= 8);
                check('req-upper',   /[A-Z]/.test(v));
                check('req-lower',   /[a-z]/.test(v));
                check('req-digit',   /\d/.test(v));
                check('req-special', /[^a-zA-Z\d]/.test(v));
            });
        })();

        // -- Theme toggle -----------------------------------------------------
        (function () {
            var btn = document.getElementById('authThemeToggle');
            var icon = document.getElementById('authThemeIcon');
            function applyTheme(t) {
                document.documentElement.setAttribute('data-theme', t);
                localStorage.setItem('theme', t);
                if (t === 'dark') { icon.className = 'bi bi-moon-fill'; }
                else { icon.className = 'bi bi-sun-fill'; }
            }
            applyTheme(localStorage.getItem('theme') || 'light');
            btn.addEventListener('click', function () {
                var cur = document.documentElement.getAttribute('data-theme');
                applyTheme(cur === 'dark' ? 'light' : 'dark');
            });
        })();
    </script>
</body>
</html>
