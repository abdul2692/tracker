@model SpendingTracker.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password - SpendTracker</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <script>
        (function(){var t=localStorage.getItem('theme')||'light';document.documentElement.setAttribute('data-theme',t);})();
    </script>
</head>
<body class="auth-body">
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-brand">
                <i class="bi bi-shield-lock-fill brand-icon-lg"></i>
                <h1 class="auth-title">Reset Password</h1>
                <p class="auth-subtitle">Enter your new password below</p>
            </div>

            <form asp-action="ResetPassword" method="post" class="auth-form">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Token" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label-custom"></label>
                    <div class="input-group-custom">
                        <i class="bi bi-lock input-icon"></i>
                        <input asp-for="NewPassword" id="resetNewPassword" class="form-control-custom" type="password" placeholder="New password" />
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>

                    <!-- Password Requirements Checklist -->
                    <div class="pw-requirements mt-2" id="resetPwChecklist">
                        <div class="pw-req" id="reset-req-len"><i class="bi bi-x-circle-fill pw-fail"></i><i class="bi bi-check-circle-fill pw-pass d-none"></i> At least 8 characters</div>
                        <div class="pw-req" id="reset-req-upper"><i class="bi bi-x-circle-fill pw-fail"></i><i class="bi bi-check-circle-fill pw-pass d-none"></i> One uppercase letter</div>
                        <div class="pw-req" id="reset-req-lower"><i class="bi bi-x-circle-fill pw-fail"></i><i class="bi bi-check-circle-fill pw-pass d-none"></i> One lowercase letter</div>
                        <div class="pw-req" id="reset-req-digit"><i class="bi bi-x-circle-fill pw-fail"></i><i class="bi bi-check-circle-fill pw-pass d-none"></i> One number</div>
                        <div class="pw-req" id="reset-req-special"><i class="bi bi-x-circle-fill pw-fail"></i><i class="bi bi-check-circle-fill pw-pass d-none"></i> One special character</div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label-custom"></label>
                    <div class="input-group-custom">
                        <i class="bi bi-lock-fill input-icon"></i>
                        <input asp-for="ConfirmPassword" class="form-control-custom" type="password" placeholder="Confirm new password" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-auth">
                    <i class="bi bi-check-circle me-2"></i>Reset Password
                </button>

                <p class="auth-footer">
                    <a asp-action="Login" class="auth-link"><i class="bi bi-arrow-left me-1"></i>Back to Login</a>
                </p>
            </form>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function() {
            var pwInput = document.getElementById('resetNewPassword');
            if (!pwInput) return;
            function check(id, test) {
                var el = document.getElementById(id);
                var pass = el.querySelector('.pw-pass');
                var fail = el.querySelector('.pw-fail');
                if (test) { pass.classList.remove('d-none'); fail.classList.add('d-none'); el.classList.add('met'); }
                else { pass.classList.add('d-none'); fail.classList.remove('d-none'); el.classList.remove('met'); }
            }
            pwInput.addEventListener('input', function() {
                var v = this.value;
                check('reset-req-len', v.length >= 8);
                check('reset-req-upper', /[A-Z]/.test(v));
                check('reset-req-lower', /[a-z]/.test(v));
                check('reset-req-digit', /\d/.test(v));
                check('reset-req-special', /[^a-zA-Z\d]/.test(v));
            });
        })();
    </script>
</body>
</html>
