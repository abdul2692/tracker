@model SpendingTracker.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password - SpendTracker</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="glass-body">
    <div class="glass-container">
        <div class="glass-card">
            <div class="glass-brand">
                <i class="bi bi-shield-lock"></i>
                <h1 class="glass-title">Reset Password</h1>
                <p class="glass-subtitle">Enter your new password below.</p>
            </div>

            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Token" />
                <input type="hidden" asp-for="Email" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert-glass alert-glass-danger">
                        <div asp-validation-summary="ModelOnly"></div>
                    </div>
                }

                <div class="mb-4">
                    <label asp-for="NewPassword" class="glass-form-label"></label>
                    <div class="glass-input-group">
                        <i class="bi bi-lock input-icon"></i>
                        <input asp-for="NewPassword" id="resetPassword" class="glass-input" placeholder="New password" type="password" />
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                    
                    <!-- Real-time password requirements -->
                    <div class="pw-requirements" id="pwChecklist">
                        <div class="pw-req" id="req-len">
                            <i class="bi bi-x-circle-fill pw-fail"></i><i class="bi bi-check-circle-fill pw-pass d-none"></i> At least 8 characters
                        </div>
                        <div class="pw-req" id="req-upper">
                            <i class="bi bi-x-circle-fill pw-fail"></i><i class="bi bi-check-circle-fill pw-pass d-none"></i> Uppercase letter (A-Z)
                        </div>
                        <div class="pw-req" id="req-lower">
                            <i class="bi bi-x-circle-fill pw-fail"></i><i class="bi bi-check-circle-fill pw-pass d-none"></i> Lowercase letter (a-z)
                        </div>
                        <div class="pw-req" id="req-digit">
                            <i class="bi bi-x-circle-fill pw-fail"></i><i class="bi bi-check-circle-fill pw-pass d-none"></i> Number (0-9)
                        </div>
                        <div class="pw-req" id="req-special">
                            <i class="bi bi-x-circle-fill pw-fail"></i><i class="bi bi-check-circle-fill pw-pass d-none"></i> Special character (!@@#$...)
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="glass-form-label"></label>
                    <div class="glass-input-group">
                        <i class="bi bi-shield-lock input-icon"></i>
                        <input asp-for="ConfirmPassword" class="glass-input" placeholder="Confirm new password" type="password" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="glass-btn mt-2">
                    <i class="bi bi-check2-circle me-2"></i>Reset Password
                </button>
            </form>
        </div>
    </div>
    
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script>
        (function () {
            var pwInput = document.getElementById('resetPassword');
            if (!pwInput) return;
            function check(id, test) {
                var el = document.getElementById(id);
                var pass = el.querySelector('.pw-pass');
                var fail = el.querySelector('.pw-fail');
                if (test) {
                    pass.classList.remove('d-none');
                    fail.classList.add('d-none');
                    el.classList.add('met');
                } else {
                    pass.classList.add('d-none');
                    fail.classList.remove('d-none');
                    el.classList.remove('met');
                }
            }
            pwInput.addEventListener('input', function () {
                var v = this.value;
                check('req-len',     v.length >= 8);
                check('req-upper',   /[A-Z]/.test(v));
                check('req-lower',   /[a-z]/.test(v));
                check('req-digit',   /\d/.test(v));
                check('req-special', /[^a-zA-Z\d]/.test(v));
            });
        })();
    </script>
</body>
</html>
