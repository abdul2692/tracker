@{
    ViewData["Title"] = "Check Your Email";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Check Your Email - SpendTracker</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <script>
        (function(){var t=localStorage.getItem('theme')||'light';document.documentElement.setAttribute('data-theme',t);})();
    </script>
</head>
<body class="auth-body">
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-brand">
                <i class="bi bi-envelope-check-fill brand-icon-lg" style="font-size:3rem;"></i>
                <h1 class="auth-title">Check Your Email</h1>
                <p class="auth-subtitle">If an account exists for that email, we sent a reset link.</p>
            </div>

            @if (TempData["ResetLink"] != null)
            {
                <div class="alert alert-info rounded-3 small mt-3">
                    <strong><i class="bi bi-info-circle me-1"></i>Developer Mode:</strong>
                    No SMTP configured. Use this link to reset:
                    <div class="mt-2">
                        <a href="@TempData["ResetLink"]" class="auth-link" style="word-break:break-all">@TempData["ResetLink"]</a>
                    </div>
                </div>
            }

            <p class="auth-footer mt-3">
                <a asp-action="Login" class="auth-link"><i class="bi bi-arrow-left me-1"></i>Back to Login</a>
            </p>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
