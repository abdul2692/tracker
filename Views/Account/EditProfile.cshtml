@model SpendingTracker.ViewModels.EditProfileViewModel
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Edit Profile</h1>
        <p class="page-subtitle">Update your personal information and password</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-7">
        <div class="card-custom">
            <div class="card-custom-header">
                <h5 class="card-custom-title"><i class="bi bi-person-circle me-2"></i>Personal Information</h5>
            </div>
            <div class="card-custom-body">
                <form asp-action="EditProfile" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small rounded-3"></div>

                    <!-- Profile Photo Section -->
                    <div class="mb-4 text-center">
                        <div class="profile-photo-container mb-3 position-relative d-inline-block">
                            @if (!string.IsNullOrEmpty(Model.ExistingProfilePicture))
                            {
                                <img id="photoPreview" src="@Model.ExistingProfilePicture" class="rounded-circle profile-photo-img shadow" style="width: 120px; height: 120px; object-fit: cover;" alt="Profile Picture" />
                                <div id="photoPlaceholder" class="rounded-circle d-flex align-items-center justify-content-center bg-primary text-white shadow fw-bold fs-2 d-none" style="width: 120px; height: 120px; margin: 0 auto;">
                                    @(Model.FirstName?.Length > 0 ? Model.FirstName.Substring(0, 1).ToUpper() : "U")
                                </div>
                            }
                            else
                            {
                                <div id="photoPlaceholder" class="rounded-circle d-flex align-items-center justify-content-center bg-primary text-white shadow fw-bold fs-2" style="width: 120px; height: 120px; margin: 0 auto;">
                                    @(Model.FirstName?.Length > 0 ? Model.FirstName.Substring(0, 1).ToUpper() : "U")
                                </div>
                                <img id="photoPreview" src="" class="rounded-circle profile-photo-img shadow d-none" style="width: 120px; height: 120px; object-fit: cover;" alt="Profile Picture Preview" />
                            }
                        </div>
                        <div class="d-flex justify-content-center align-items-center gap-2 flex-wrap">
                            <label for="ProfilePhoto" class="btn btn-sm btn-outline-primary mb-0">
                                <i class="bi bi-camera-fill me-1"></i>Choose Photo
                            </label>
                            <input asp-for="ProfilePhoto" type="file" accept=".jpg,.jpeg,.png" class="d-none" id="ProfilePhoto" onchange="previewSelectedPhoto(this)" />
                            
                            <button type="button" id="btnDeletePhoto" class="btn btn-sm btn-outline-danger @(string.IsNullOrEmpty(Model.ExistingProfilePicture) ? "d-none" : "")" onclick="handleDeleteOrClearPhoto()">
                                <i class="bi bi-trash-fill me-1"></i>Delete Photo
                            </button>
                        </div>
                        <div class="form-text text-muted small mt-2">
                            Allowed formats: JPG, PNG, JPEG. Max size: 2MB.
                        </div>
                        <span asp-validation-for="ProfilePhoto" class="text-danger small d-block"></span>
                    </div>

                    <!-- Hidden Form for Delete Profile Picture -->
                    @if (!string.IsNullOrEmpty(Model.ExistingProfilePicture))
                    {
                        <input type="hidden" asp-for="DeletePhoto" id="DeletePhotoInput" value="false" />
                    }

                    <div class="row g-3">
                        <div class="col-6">
                            <label asp-for="FirstName" class="form-label-custom"></label>
                            <input asp-for="FirstName" class="form-control form-control-dark" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="LastName" class="form-label-custom"></label>
                            <input asp-for="LastName" class="form-control form-control-dark" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Email" class="form-label-custom"></label>
                            <input asp-for="Email" class="form-control form-control-dark" readonly />
                        </div>
                        <div class="col-12">
                            <label asp-for="Currency" class="form-label-custom"></label>
                            <select asp-for="Currency" class="form-select form-control-dark">
                                <option value="USD">USD - US Dollar ($)</option>
                                <option value="EUR">EUR - Euro (€)</option>
                                <option value="GBP">GBP - British Pound (£)</option>
                                <option value="INR">INR - Indian Rupee (₹)</option>
                                <option value="PKR">PKR - Pakistani Rupee (Rs)</option>
                                <option value="AED">AED - UAE Dirham (د.إ)</option>
                                <option value="CAD">CAD - Canadian Dollar (CA$)</option>
                                <option value="AUD">AUD - Australian Dollar (A$)</option>
                            </select>
                        </div>
                    </div>

                    <hr class="form-divider my-4" />
                    <h6 class="mb-3 text-muted"><i class="bi bi-shield-lock me-2"></i>Change Password (optional)</h6>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="CurrentPassword" class="form-label-custom"></label>
                            <input asp-for="CurrentPassword" class="form-control form-control-dark" type="password" />
                        </div>
                        <div class="col-6">
                            <label asp-for="NewPassword" class="form-label-custom"></label>
                            <input asp-for="NewPassword" class="form-control form-control-dark" type="password" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="ConfirmNewPassword" class="form-label-custom"></label>
                            <input asp-for="ConfirmNewPassword" class="form-control form-control-dark" type="password" />
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary-custom">
                            <i class="bi bi-check-lg me-1"></i>Save Changes
                        </button>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary-custom">Cancel</a>
                    </div>
                </form>

                <form id="deletePhotoForm" asp-action="DeleteProfilePicture" method="post" class="d-none">
                    @Html.AntiForgeryToken()
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const hasExistingPhoto = @(string.IsNullOrEmpty(Model.ExistingProfilePicture) ? "false" : "true");

        function previewSelectedPhoto(input) {
            const file = input.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const preview = document.getElementById('photoPreview');
                    const placeholder = document.getElementById('photoPlaceholder');
                    const deleteBtn = document.getElementById('btnDeletePhoto');
                    preview.src = e.target.result;
                    preview.classList.remove('d-none');
                    if (placeholder) placeholder.classList.add('d-none');
                    if (deleteBtn) deleteBtn.classList.remove('d-none');
                };
                reader.readAsDataURL(file);
            }
        }

        function handleDeleteOrClearPhoto() {
            const fileInput = document.getElementById('ProfilePhoto');
            if (fileInput && fileInput.files.length > 0 && !hasExistingPhoto) {
                fileInput.value = '';
                const preview = document.getElementById('photoPreview');
                const placeholder = document.getElementById('photoPlaceholder');
                const deleteBtn = document.getElementById('btnDeletePhoto');
                preview.src = '';
                preview.classList.add('d-none');
                if (placeholder) placeholder.classList.remove('d-none');
                if (deleteBtn) deleteBtn.classList.add('d-none');
                return;
            }

            if (confirm('Are you sure you want to delete your profile picture?')) {
                document.getElementById('deletePhotoForm').submit();
            }
        }
    </script>
}
