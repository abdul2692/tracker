@model SpendingTracker.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - SpendTracker</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="glass-body">
    <div class="glass-container">
        <div class="glass-card">
            <div class="glass-brand">
                <i class="bi bi-key"></i>
                <h1 class="glass-title">Forgot Password</h1>
                <p class="glass-subtitle">Enter your email to receive a reset link.</p>
            </div>

            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert-glass alert-glass-danger">
                        <div asp-validation-summary="ModelOnly"></div>
                    </div>
                }

                <div class="mb-4">
                    <label asp-for="Email" class="glass-form-label"></label>
                    <div class="glass-input-group">
                        <i class="bi bi-envelope input-icon"></i>
                        <input asp-for="Email" class="glass-input" placeholder="your@email.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <button type="submit" class="glass-btn">
                    <i class="bi bi-envelope-paper me-2"></i>Send Reset Link
                </button>

                <p class="glass-footer">
                    Remembered your password? <a asp-action="Login" class="glass-link">Sign in</a>
                </p>
            </form>
        </div>
    </div>
    
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
