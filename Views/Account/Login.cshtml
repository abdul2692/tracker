@model SpendingTracker.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - SpendingTracker</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <script>
        (function () { var t = localStorage.getItem('theme') || 'light'; document.documentElement.setAttribute('data-theme', t); })();
    </script>
</head>
<body class="auth-body">
    <!-- Theme toggle -->
    <button class="theme-toggle-auth" id="authThemeToggle" title="Toggle theme" aria-label="Toggle theme">
        <i class="bi bi-sun-fill" id="authThemeIcon"></i>
    </button>

    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-brand">
                <i class="bi bi-wallet2 brand-icon-lg"></i>
                <h1 class="auth-title">SpendTracker</h1>
                <p class="auth-subtitle">Sign in to your account</p>
            </div>

            <form asp-action="Login" method="post" class="auth-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label-custom"></label>
                    <div class="input-group-custom">
                        <i class="bi bi-envelope input-icon"></i>
                        <input asp-for="Email" class="form-control-custom" placeholder="your@email.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label-custom"></label>
                    <div class="input-group-custom">
                        <i class="bi bi-lock input-icon"></i>
                        <input asp-for="Password" class="form-control-custom" placeholder="Your password" type="password" autocomplete="current-password" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                    <div class="text-end mt-1">
                        <a asp-action="ForgotPassword" class="auth-link" style="font-size:0.78rem;">Forgot Password?</a>
                    </div>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMe" />
                    <label class="form-check-label text-muted" for="rememberMe">Remember me</label>
                </div>

                <button type="submit" class="btn btn-auth">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                </button>

                <p class="auth-footer">
                    Don''t have an account? <a asp-action="Register" class="auth-link">Create one</a>
                </p>
            </form>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script>
        (function () {
            var btn = document.getElementById('authThemeToggle');
            var icon = document.getElementById('authThemeIcon');
            function applyTheme(t) {
                document.documentElement.setAttribute('data-theme', t);
                localStorage.setItem('theme', t);
                if (t === 'dark') { icon.className = 'bi bi-moon-fill'; }
                else { icon.className = 'bi bi-sun-fill'; }
            }
            // Init icon
            applyTheme(localStorage.getItem('theme') || 'light');
            btn.addEventListener('click', function () {
                var cur = document.documentElement.getAttribute('data-theme');
                applyTheme(cur === 'dark' ? 'light' : 'dark');
            });
        })();
    </script>
</body>
</html>
