@model SpendingTracker.Models.Expense
@{
    ViewData["Title"] = "Delete Expense";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Delete Expense</h1>
        <p class="page-subtitle">This action cannot be undone</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary-custom">
        <i class="bi bi-arrow-left me-1"></i>Back
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-5">
        <div class="card-custom border-danger-soft">
            <div class="card-custom-body text-center py-4">
                <div class="mb-3">
                    <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size:3rem"></i>
                </div>
                <h5 class="mb-3">Are you sure you want to delete this expense?</h5>

                <div class="detail-box mb-4">
                    <div class="detail-row">
                        <span class="detail-label">Category</span>
                        <span class="detail-value">
                            <i class="@Model.Category.Icon me-1" style="color:@Model.Category.Color"></i>
                            @Model.Category.Name
                        </span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Amount</span>
                        <span class="detail-value text-danger fw-600">-@ViewBag.CurrencySymbol@Model.Amount.ToString("N2")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Date</span>
                        <span class="detail-value">@Model.Date.ToString("MMMM dd, yyyy")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Payment</span>
                        <span class="detail-value">@Model.PaymentMethod</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="detail-row">
                            <span class="detail-label">Description</span>
                            <span class="detail-value">@Model.Description</span>
                        </div>
                    }
                </div>

                <form asp-action="Delete" method="post" class="d-flex gap-2 justify-content-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger-custom">
                        <i class="bi bi-trash-fill me-1"></i>Yes, Delete
                    </button>
                    <a asp-action="Index" class="btn btn-secondary-custom">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

