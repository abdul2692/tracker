@model SpendingTracker.ViewModels.ExpenseViewModel
@{
    ViewData["Title"] = "Edit Expense";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Edit Expense</h1>
        <p class="page-subtitle">Update your expense record</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary-custom">
        <i class="bi bi-arrow-left me-1"></i>Back
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-6">
        <div class="card-custom">
            <div class="card-custom-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small rounded-3"></div>

                    <div class="mb-3">
                        <label asp-for="Amount" class="form-label-custom"></label>
                        <div class="input-group-custom">
                            <i class="bi bi-currency-dollar input-icon"></i>
                            <input asp-for="Amount" class="form-control-custom" type="number" step="0.01" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label-custom"></label>
                        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select form-control-dark">
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PaymentMethod" class="form-label-custom"></label>
                        <select asp-for="PaymentMethod" class="form-select form-control-dark"
                                asp-items="Html.GetEnumSelectList<SpendingTracker.Models.PaymentMethod>()">
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Date" class="form-label-custom"></label>
                        <div class="input-group-custom">
                            <i class="bi bi-calendar3 input-icon"></i>
                            <input asp-for="Date" class="form-control-custom" type="date" />
                        </div>
                        <span asp-validation-for="Date" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label-custom"></label>
                        <textarea asp-for="Description" class="form-control form-control-dark" rows="3"></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary-custom">
                            <i class="bi bi-check-lg me-1"></i>Update Expense
                        </button>
                        <a asp-action="Index" class="btn btn-secondary-custom">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
