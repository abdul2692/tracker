@model IEnumerable<SpendingTracker.Models.Expense>
@{
    ViewData["Title"] = "Expenses";
    int page = ViewBag.Page;
    int totalPages = ViewBag.TotalPages;
    var categories = ViewBag.Categories as IEnumerable<SpendingTracker.Models.Category> ?? Enumerable.Empty<SpendingTracker.Models.Category>();
}

<div class="page-header">
    <div>
        <h1 class="page-title">Expenses</h1>
        <p class="page-subtitle">Total: <strong class="text-danger">$@ViewBag.TotalExpenses.ToString("N2")</strong> — @ViewBag.TotalCount records</p>
    </div>
    <a asp-action="Create" class="btn btn-danger-custom">
        <i class="bi bi-plus-circle me-1"></i>Add Expense
    </a>
</div>

<!-- Filters -->
<div class="card-custom mb-4">
    <div class="card-custom-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <div class="input-group-custom">
                    <i class="bi bi-search input-icon"></i>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control-custom" placeholder="Search expenses..." />
                </div>
            </div>
            <div class="col-6 col-md-3">
                <select name="categoryId" class="form-select form-control-dark">
                    <option value="">All Categories</option>
                    @foreach (var cat in categories)
                    {
                        <option value="@cat.Id" selected="@(ViewBag.CategoryId != null && (int)ViewBag.CategoryId == cat.Id)">@cat.Name</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <select name="sortBy" class="form-select form-control-dark">
                    <option value="">Sort: Latest First</option>
                    <option value="date_asc" selected="@(ViewBag.SortBy == "date_asc")">Sort: Oldest First</option>
                    <option value="amount_desc" selected="@(ViewBag.SortBy == "amount_desc")">Sort: Highest Amount</option>
                    <option value="amount_asc" selected="@(ViewBag.SortBy == "amount_asc")">Sort: Lowest Amount</option>
                    <option value="category" selected="@(ViewBag.SortBy == "category")">Sort: Category</option>
                </select>
            </div>
            <div class="col-12 col-md-2">
                <button type="submit" class="btn btn-primary-custom w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card-custom">
    <div class="card-custom-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-custom mb-0">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th>Category</th>
                            <th>Payment</th>
                            <th>Date</th>
                            <th class="text-end">Amount</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var expense in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="icon-circle me-2" style="background:@(expense.Category.Color)22">
                                            <i class="@expense.Category.Icon" style="color:@expense.Category.Color"></i>
                                        </div>
                                        <span class="fw-500">@(expense.Description ?? expense.Category.Name)</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge-category" style="background:@(expense.Category.Color)22;color:@expense.Category.Color">
                                        @expense.Category.Name
                                    </span>
                                </td>
                                <td class="text-muted small">@expense.PaymentMethod</td>
                                <td class="text-muted">@expense.Date.ToString("MMM dd, yyyy")</td>
                                <td class="text-end fw-600 text-danger">-$@expense.Amount.ToString("N2")</td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@expense.Id" class="btn-icon btn-icon-edit" title="Edit">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@expense.Id" class="btn-icon btn-icon-delete" title="Delete">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="pagination-wrapper">
                    <nav>
                        <ul class="pagination-custom">
                            @if (page > 1)
                            {
                                <li><a class="page-btn" asp-action="Index" asp-route-page="@(page-1)" asp-route-search="@ViewBag.Search" asp-route-sortBy="@ViewBag.SortBy" asp-route-categoryId="@ViewBag.CategoryId"><i class="bi bi-chevron-left"></i></a></li>
                            }
                            @for (int i = Math.Max(1, page - 2); i <= Math.Min(totalPages, page + 2); i++)
                            {
                                var btnCls = i == page ? "page-btn active" : "page-btn";
                                <li><a class="@btnCls" asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search" asp-route-sortBy="@ViewBag.SortBy" asp-route-categoryId="@ViewBag.CategoryId">@i</a></li>
                            }
                            @if (page < totalPages)
                            {
                                <li><a class="page-btn" asp-action="Index" asp-route-page="@(page+1)" asp-route-search="@ViewBag.Search" asp-route-sortBy="@ViewBag.SortBy" asp-route-categoryId="@ViewBag.CategoryId"><i class="bi bi-chevron-right"></i></a></li>
                            }
                        </ul>
                    </nav>
                    <span class="text-muted small">Page @(page) of @totalPages</span>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-receipt empty-icon"></i>
                <h5>No expenses found</h5>
                <p class="text-muted">Start tracking your spending.</p>
                <a asp-action="Create" class="btn btn-danger-custom mt-2"><i class="bi bi-plus-circle me-1"></i>Add Expense</a>
            </div>
        }
    </div>
</div>
